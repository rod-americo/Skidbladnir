{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skidbladnir.local/schema/deploy-manifest.schema.json",
  "title": "Skidbladnir Deploy Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "project",
    "runtime",
    "deploy",
    "process",
    "healthcheck",
    "ports",
    "environment",
    "secrets",
    "runtime_state",
    "logs",
    "restart",
    "backup",
    "rollback"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "slug"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "deploy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "reason"],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string"
        },
        "working_directory": {
          "type": "string"
        },
        "user": {
          "type": "string"
        }
      }
    },
    "healthcheck": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "command": {
          "type": "string"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "http": {
          "type": "object",
          "required": ["url"],
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "ports": {
      "type": "array"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "runtime_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths"],
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "logs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths"],
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "restart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy"],
      "properties": {
        "policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy"],
      "properties": {
        "policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy"],
      "properties": {
        "strategy": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
